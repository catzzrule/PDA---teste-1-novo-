# Copie para .env se for rodar o backend fora do docker-compose (ex.: `uvicorn app.main:app --reload`).
# Ao usar `docker compose up`, essas variáveis já vêm definidas no docker-compose.yml.

DATABASE_URL=postgresql+asyncpg://pda:pda@localhost:5432/pda
JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Opcional — sem essas variáveis, notificações só ficam gravadas na tabela
# `notificacoes` e no log do console (ver app/services/notification.py).
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=pda-noreply@esporte.gov.br

# Usados só pelo `python -m app.seed`:
SEED_MASTER_EMAIL=admin.cgti@esporte.gov.br
SEED_MASTER_PASSWORD=TrocarSenha123
